# Все переменные необязательны: сайт открывается и без них.
# Не кладите сюда настоящие пароли. Рабочие значения — только в окружении хостинга.

# Канонический адрес сайта для ссылок, sitemap и Open Graph.
# NEXT_PUBLIC_SITE_ORIGIN="https://example.com"

# Куда отправлять заявки и резюме. Если MAIL_TO не задан, получатель — gorgros26@mail.ru.
# MAIL_TO="gorgros26@mail.ru"

# SMTP включается только если заданы HOST, USER и PASS.
# Учётные данные здесь не хранятся. Пока их нет, форма честно сообщает, что письмо не отправлено.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
