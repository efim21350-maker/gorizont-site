# Все переменные необязательны: сайт открывается и без них.
# Не кладите сюда настоящие пароли. Рабочие значения — только в окружении хостинга.

# Канонический адрес сайта для ссылок, sitemap и Open Graph.
# NEXT_PUBLIC_SITE_ORIGIN="https://example.com"

# Куда отправлять заявки с формы. Почта компании, не личная:
# ivangrosu127@gmail.com и buh.gorizont@internet.ru
# CONTACT_TO="ivangrosu127@gmail.com, buh.gorizont@internet.ru"

# SMTP включается только если заданы все четыре значения: HOST, USER, PASS и CONTACT_TO.
# Пока их нет, форма остаётся на сайте и честно сообщает, что письмо не отправлено.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
